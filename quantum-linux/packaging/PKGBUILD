# Maintainer: sidmax
pkgname=quantumengine
pkgver=0.4.8
pkgrel=1
pkgdesc="Control JBL Quantum 810 Wireless headsets: ANC, sidetone, lighting, EQ, virtual surround (GUI, tray, Plasma widget, CLI)"
arch=('x86_64' 'aarch64')
url="https://github.com/sidmax7/QuantumEngine"
license=('MIT OR Apache-2.0')
# The window is a Tauri app on the system WebKitGTK. The background service
# (tray icon, headset, EQ, updates) needs none of that: it speaks D-Bus, and
# reads libmysofa's HRTF data for virtual surround.
depends=('glibc' 'libgcc' 'hicolor-icon-theme' 'webkit2gtk-4.1' 'gtk3' 'curl'
         'libmysofa')
makedepends=('cargo' 'npm')
optdepends=('pipewire: the equalizer'
            'wireplumber: the equalizer (0.5 or newer)'
            'pipewire-audio: virtual 7.1 surround'
            'polkit: installing updates from the app'
            'plasma5support: the QuantumEngine Plasma widget'
            'plasma-workspace: the QuantumEngine Plasma widget')
# The release binaries carry no debug info worth a separate package, and the
# in-app updater must only ever find the one package in a release.
options=('!debug')
# The app lives in the quantum-linux/ subdirectory of the QuantumEngine repo,
# alongside research material that isn't part of this package.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The release workflow (.github/workflows/release.yml) fills this in with
# updpkgsums and attaches that PKGBUILD to the GitHub release; use that copy
# for the AUR.
sha256sums=('SKIP')

_srcdir=QuantumEngine-$pkgver/quantum-linux

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm --prefix ui ci --no-audit --no-fund
}

build() {
  cd "$_srcdir"
  # The window's interface (Vue), built into ui/dist and embedded in the
  # quantumengine binary below.
  npm --prefix ui run build
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace --features quantumengine/custom-protocol
}

check() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --workspace
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/quantumenginectl -t "$pkgdir/usr/bin/"
  install -Dm755 target/release/quantumengine -t "$pkgdir/usr/bin/"
  install -Dm755 target/release/quantumengined -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/quantumengine.desktop -t "$pkgdir/usr/share/applications/"
  # Starts the tray icon and headset service at login; users can switch it
  # off in their desktop's autostart settings.
  install -Dm644 packaging/quantumengine-tray.desktop -t "$pkgdir/etc/xdg/autostart/"
  local plasmoid=org.quantumengine.plasmoid
  find "packaging/plasmoid/$plasmoid" -type f -printf '%P\n' | while read -r f; do
    install -Dm644 "packaging/plasmoid/$plasmoid/$f" "$pkgdir/usr/share/plasma/plasmoids/$plasmoid/$f"
  done
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/quantumengine.png" \
      -t "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/"
  done
  # Packaged rules belong in /usr/lib; /etc/udev/rules.d is for the admin.
  install -Dm644 udev/70-jbl-quantum.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
